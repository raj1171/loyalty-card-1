# ============================================================================
# Digital Loyalty Platform — Environment Variables Example
# ============================================================================

# ----------------------------------------------------------------------------
# 1. PUBLIC CONFIGURATION (Accessible in Browser & Frontend)
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
VITE_API_BASE_URL=https://api.loyalty.yourdomain.com
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAABBBBBBCCCCCCDD

# ----------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Cloudflare Workers API & Admin Only)
# NEVER EXPOSE THESE IN FRONTEND CODE OR COMMIT TO REPOSITORIES!
# ----------------------------------------------------------------------------
ENVIRONMENT=production

# Supabase Server Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-super-secret-service-role-key

# Cloudflare Turnstile Secret Key (for server-side bot validation)
TURNSTILE_SECRET_KEY=0x4AAAAAAABBBBBBCCCCCCDD_SECRET_KEY

# Optional: Cloudflare Account ID & API Tokens for deployment
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
